{{template "base" .}}
{{define "title"}}Events{{end}}
{{define "body"}}
<div class="page-header">
    <h2>Live Events & Tournaments</h2>
</div>

<!-- NAYA FORM YAHAN ADD KIYA HAI -->
<div class="add-event-section" style="margin-bottom: 30px; padding: 15px; border: 1px solid #444; border-radius: 8px;">
    <h3 style="margin-top: 0;">Create a New Event</h3>
    <form action="/add-event" method="POST" enctype="multipart/form-data">
        <input type="text" name="title" placeholder="Event Title" required style="padding: 8px; margin-right: 10px;">
        <input type="file" name="event_image" accept="image/png, image/jpeg" required style="margin-right: 10px;">
        <button type="submit" style="padding: 8px 15px; cursor: pointer;">Post Event</button>
    </form>
</div>
<!-- NAYA FORM END -->

<div class="events-container">
    {{if .}}
        <!-- Agar events hain, toh loop chalao -->
        {{range .}}
        <div class="event-box" style="margin-bottom: 20px; text-align: center;">
            <img src="{{.ImagePath}}" alt="{{.Title}}" style="max-width: 100%; border-radius: 8px; max-height: 200px; object-fit: cover;">
            <h3>{{.Title}}</h3>
        </div>
        {{end}}
    {{else}}
        <!-- Agar database me koi event nahi hai -->
        <p style="text-align: center; color: #888;">No events currently active. Be the first to create one!</p>
    {{end}}
</div>
<button class="fab-btn" title="Add New Event">+</button>
{{end}}